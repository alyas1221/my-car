<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>داشبورد | My-Car</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="dash">
    <aside class="sidebar">
      <div style="font-weight:bold;font-size:13px;margin-bottom:8px;">منوی اصلی</div>
      <a href="/dashboard" class="active">داشبورد</a>
      <a href="/vehicles">خودروهای من</a>
      <a href="/services">سرویس‌ها</a>
      <a href="/social">شبکه اجتماعی</a>
      <a href="/forum">تالار گفتگو</a>
      <a href="/profile">پروفایل</a>
      <% if (user.role === "admin" || user.role === "super_admin") { %>
      <a href="/admin" style="margin-top:10px;border-top:1px solid #e2e8f0;padding-top:10px;color:#2563eb;">پنل مدیریت</a>
      <% } %>
    </aside>
    <main>
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;">
        <div>
          <strong><%= user.firstName %> <%= user.lastName %></strong>
          <div style="font-size:11px;color:#64748b;">نقش: <%= user.role %></div>
        </div>
        <form action="/auth/logout" method="POST" style="margin:0;">
          <button type="submit" class="btn-outline" style="padding:4px 10px;font-size:12px;">خروج</button>
        </form>
      </div>
      <div class="row" style="margin-top:10px;">
        <div class="col card"><h3 style="font-size:13px;margin-bottom:8px;">خودروهای من</h3><p style="font-size:12px;color:#64748b;">به زودی...</p></div>
        <div class="col card"><h3 style="font-size:13px;margin-bottom:8px;">سرویس‌های اخیر</h3><p style="font-size:12px;color:#64748b;">به زودی...</p></div>
      </div>
    </main>
    <aside class="sidebar">
      <div style="font-weight:bold;font-size:12px;margin-bottom:6px;">کاربران آنلاین</div>
      <div class="online-list" id="onlineList">
        <div style="font-size:11px;color:#94a3b8;">در حال اتصال...</div>
      </div>
    </aside>
  </div>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io("https://car.dedhban.ir", { path: "/socket.io/" });
    socket.emit("user:join", { name: "<%= user.firstName %> <%= user.lastName %>", role: "<%= user.role %>" });
    socket.on("users:online", (users) => {
      const el = document.getElementById("onlineList");
      if (!users.length) { el.innerHTML = "<div style=\"font-size:11px;color:#94a3b8;\">کسی آنلاین نیست</div>"; return; }
      el.innerHTML = users.map(u => `<div class="online-item"><span class="online-dot"></span><span>${u.name}</span></div>`).join("");
    });
  </script>
</body>
</html>
