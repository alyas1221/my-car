<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ثبت نام | My-Car</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-wrap" style="align-items:flex-start;padding-top:30px;">
    <div class="card" style="width:100%;max-width:500px;">
      <h1 style="font-size:16px;text-align:center;margin-bottom:15px;">ثبت نام کاربر جدید</h1>
      <form action="/auth/register" method="POST">
        <div class="row">
          <div class="col"><div class="form-group"><label>نام</label><input type="text" name="firstName" required></div></div>
          <div class="col"><div class="form-group"><label>نام خانوادگی</label><input type="text" name="lastName" required></div></div>
        </div>
        <div class="form-group"><label>شماره تماس (نام کاربری)</label><input type="text" name="phone" required placeholder="09xxxxxxxxx"></div>
        <div class="form-group"><label>رمز عبور</label><input type="password" name="password" required></div>
        <div class="form-group"><label>تکرار رمز عبور</label><input type="password" name="password2" required></div>
        <hr style="margin:15px 0;border:none;border-top:1px solid #e2e8f0;">
        <h3 style="font-size:13px;margin-bottom:10px;">مشخصات خودرو (اختیاری)</h3>
        <div class="row">
          <div class="col"><div class="form-group"><label>نوع خودرو</label><select name="vehicleType"><option value="car">ماشین</option><option value="motorcycle">موتور</option></select></div></div>
          <div class="col"><div class="form-group"><label>مدل</label><input type="text" name="vehicleModel"></div></div>
        </div>
        <div class="row">
          <div class="col"><div class="form-group"><label>سال تولید</label><input type="text" name="vehicleYear" placeholder="1402"></div></div>
          <div class="col"><div class="form-group"><label>پلاک</label><input type="text" name="plate" placeholder="12ع345-67"></div></div>
        </div>
        <div class="form-group"><label>کارکرد اولیه (کیلومتر)</label><input type="number" name="initialKm" placeholder="0"></div>
        <div class="form-group"><label>آدرس</label><textarea name="address" rows="2"></textarea></div>
        <button type="submit" style="width:100%;margin-top:10px;">ثبت نام</button>
      </form>
      <div style="text-align:center;margin-top:10px;font-size:12px;"><a href="/login">بازگشت به ورود</a></div>
    </div>
  </div>
</body>
</html>
