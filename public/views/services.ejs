<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>سرویس‌ها | My-Car</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="dash">
    <aside class="sidebar">
      <div style="font-weight:bold;font-size:13px;margin-bottom:8px;">منوی اصلی</div>
      <a href="/dashboard">داشبورد</a>
      <a href="/vehicles">خودروهای من</a>
      <a href="/services" class="active">سرویس‌ها</a>
      <a href="/social">شبکه اجتماعی</a>
      <a href="/forum">تالار گفتگو</a>
      <a href="/profile">پروفایل</a>
    </aside>
    <main>
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;">
        <strong style="font-size:14px;">سرویس‌ها</strong>
        <button onclick="document.getElementById('addForm').style.display='block'" style="font-size:12px;padding:4px 10px;">+ ثبت سرویس</button>
      </div>
      <div id="addForm" class="card" style="display:none;margin-top:10px;">
        <h3 style="font-size:13px;margin-bottom:10px;">سرویس جدید</h3>
        <% if (vehicles.length === 0) { %>
        <p style="font-size:12px;color:#ef4444;">ابتدا یک خودرو ثبت کنید.</p>
        <% } else { %>
        <form action="/services/add" method="POST">
          <div class="form-group"><label>خودرو</label><select name="vehicle_id" required><% vehicles.forEach(v => { %><option value="<%= v.id %>"><%= v.model %> - <%= v.plate || "بدون پلاک" %></option><% }) %></select></div>
          <div class="row">
            <div class="col"><div class="form-group"><label>نوع سرویس</label><select name="service_type" required><option value="oil">تعویض روغن</option><option value="spark">شمع</option><option value="disk">دیسک</option><option value="tire">لاستیک</option><option value="battery">باتری</option><option value="other">سایر</option></select></div></div>
            <div class="col"><div class="form-group"><label>کیلومتر</label><input type="number" name="km" required></div></div>
          </div>
          <div class="form-group"><label>تاریخ (هجری شمسی)</label><input type="text" name="service_date" placeholder="1402/10/15" required></div>
          <div class="form-group"><label>هزینه (تومان)</label><input type="number" name="cost" placeholder="0"></div>
          <div class="form-group"><label>توضیحات</label><textarea name="description" rows="2"></textarea></div>
          <button type="submit">ثبت سرویس</button>
        </form>
        <% } %>
      </div>
      <div class="card" style="margin-top:10px;">
        <h3 style="font-size:13px;margin-bottom:8px;">لیست سرویس‌ها</h3>
        <% if (services.length === 0) { %>
        <p style="font-size:12px;color:#64748b;">هنوز سرویسی ثبت نشده است.</p>
        <% } else { %>
        <table style="width:100%;font-size:12px;border-collapse:collapse;">
          <tr style="border-bottom:1px solid #e2e8f0;"><th align="right">خودرو</th><th align="right">نوع</th><th align="right">تاریخ</th><th align="right">کیلومتر</th><th align="right">هزینه</th></tr>
          <% services.forEach(s => { %>
          <tr><td style="padding:6px 0;"><%= s.vehicle_name %></td><td><%= s.service_type %></td><td><%= s.service_date %></td><td><%= s.km %></td><td><%= s.cost || 0 %></td></tr>
          <% }) %>
        </table>
        <% } %>
      </div>
    </main>
    <aside class="sidebar">
      <div style="font-weight:bold;font-size:12px;margin-bottom:6px;">کاربران آنلاین</div>
      <div class="online-list" id="onlineList"><div style="font-size:11px;color:#94a3b8;">در حال اتصال...</div></div>
    </aside>
  </div>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io("https://car.dedhban.ir", { path: "/socket.io/" });
    socket.emit("user:join", { name: "<%= user.firstName %> <%= user.lastName %>", role: "<%= user.role %>" });
    socket.on("users:online", (users) => {
      const el = document.getElementById("onlineList");
      el.innerHTML = users.map(u => `<div class="online-item"><span class="online-dot"></span><span>${u.name}</span></div>`).join("") || "<div style=\"font-size:11px;color:#94a3b8;\">کسی آنلاین نیست</div>";
    });
  </script>
</body>
</html>
